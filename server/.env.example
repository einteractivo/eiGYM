# =====================================================
# eiGYM - Variables de Entorno (Ejemplo)
# Copia este archivo como .env y completa los valores
# =====================================================

# Conexión a la base de datos MySQL
# Desarrollo (XAMPP): mysql://root:@127.0.0.1:3306/eigym
# Producción (cPanel): mysql://usuario_db:contraseña@localhost:3306/nombre_db
DATABASE_URL="mysql://root:@127.0.0.1:3306/eigym"

# Puerto del servidor Node.js
PORT=3000

# Clave secreta JWT - Cambia esto en producción (mínimo 32 caracteres aleatorios)
JWT_SECRET="cambia_esto_por_una_clave_secreta_segura_2026"

# URL del frontend (para CORS)
# Desarrollo: http://localhost:5173
# Producción: https://tudominio.com
FRONTEND_URL="http://localhost:5173"

# Entorno de ejecución
# Valores: development | production
NODE_ENV="development"
